# Copy to .env and fill in (never commit .env)
# FRED_API_KEY=
# FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Watchlist auto-alert (scripts/watchlist_alert.py / run_alert.bat) ---
# Telegram (recommended, free):
# 1) Telegram 找 @BotFather → /newbot → 复制 token
# 2) 给你的 bot 发一条消息，再打开:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    从结果里复制 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: generic webhook for Make.com / n8n / Zapier → WhatsApp etc.
# POST JSON: { "text": "...", "symbol": "AAPL", ... }
# ALERT_WEBHOOK_URL=https://hook.make.com/xxxx
